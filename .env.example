# Public production origin used for canonical URLs, sitemap, robots and JSON-LD.
# On Vercel this is optional: VERCEL_PROJECT_PRODUCTION_URL is used automatically.
NEXT_PUBLIC_SITE_URL=https://www.nilebed.com

# Optional — order inbox for POST /api/order (the "Submit order" button on /order).
# Paste the HTTPS URL of a Google Apps Script Web App (or any JSON webhook) that
# records orders in a Google Sheet. See docs/order-submission-2026-11-02.md.
# Leave it empty to build normally: the order builder then prepares a ready-made
# WhatsApp / email message instead. No secret is required to build the site.
# The deployment URL acts as a capability token — do not commit a real one.
ORDER_WEBHOOK_URL=

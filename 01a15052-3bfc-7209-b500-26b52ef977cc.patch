+'use client';
+
+import { useEffect, useState } from 'react';
+import { usePathname } from 'next/navigation';
+
+/** Load the legacy Firebase auth shell only for the PMO application routes.
+ * The public Nile Bed landing page should remain independently previewable. */
+export default function AppProviders({ children }: { children: React.ReactNode }) {
+  const pathname = usePathname();
+  const [AuthProvider, setAuthProvider] = useState<React.ComponentType<{ children: React.ReactNode }> | null>(null);
+
+  useEffect(() => {
+    if (pathname === '/') {
+      setAuthProvider(null);
+      return;
+    }
+    let active = true;
+    import('@/lib/auth/AuthContext').then((module) => {
+      if (active) setAuthProvider(() => module.AuthProvider);
+    });
+    return () => { active = false; };
+  }, [pathname]);
+
+  return AuthProvider ? <AuthProvider>{children}</AuthProvider> : <>{children}</>;
+}
